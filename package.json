{
  "name": "@b9g/crank",
  "version": "0.7.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/bikeshaving/crank.git"
  },
  "type": "module",
  "main": "./dist/crank.cjs",
  "module": "./dist/crank.js",
  "types": "./dist/crank.d.ts",
  "devDependencies": {
    "@b9g/eslint-config": "^0.1.3",
    "@b9g/libuild": "^0.2.20",
    "@b9g/skillpack": "^0.1.6",
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "^22.14.0",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.39.0",
    "eslint-plugin-acrocase": "^0.1.0",
    "eslint-plugin-crank": "workspace:*",
    "eslint-plugin-esfold": "^0.1.0",
    "playwright": "^1.62.1",
    "sinon": "^17.0.2",
    "typescript": "^5.8.3"
  },
  "bugs": {
    "url": "https://github.com/bikeshaving/crank/issues"
  },
  "description": "The Just JavaScript UI Framework.",
  "homepage": "https://crank.js.org",
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "libuild build",
    "publish": "libuild publish",
    "lint": "eslint .",
    "test": "npm run test:core && npm run test:eslint && npm run test:crankdown",
    "test:core": "libuild test test/ --platform chromium",
    "test:crankdown": "cd packages/crankdown && npm run typecheck && bun test",
    "test:eslint": "cd packages/eslint-plugin-crank && bun test",
    "typecheck": "tsc --noEmit",
    "skill": "skillpack SKILL.md -o skills/",
    "prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use libuild publish instead.' && exit 1"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/crank.d.ts",
      "browser": {
        "types": "./dist/standalone.d.ts",
        "import": "./dist/standalone.js",
        "require": "./dist/standalone.cjs"
      },
      "import": "./dist/crank.js",
      "require": "./dist/crank.cjs"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "require": "./dist/async.cjs"
    },
    "./async.js": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "require": "./dist/async.cjs"
    },
    "./crank": {
      "types": "./dist/crank.d.ts",
      "import": "./dist/crank.js",
      "require": "./dist/crank.cjs"
    },
    "./crank.js": {
      "types": "./dist/crank.d.ts",
      "import": "./dist/crank.js",
      "require": "./dist/crank.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./dom.js": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./event-target": {
      "types": "./dist/event-target.d.ts",
      "import": "./dist/event-target.js",
      "require": "./dist/event-target.cjs"
    },
    "./event-target.js": {
      "types": "./dist/event-target.d.ts",
      "import": "./dist/event-target.js",
      "require": "./dist/event-target.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./html.js": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./jsx-dev-runtime.js": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-runtime.js": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-tag": {
      "types": "./dist/jsx-tag.d.ts",
      "import": "./dist/jsx-tag.js",
      "require": "./dist/jsx-tag.cjs"
    },
    "./jsx-tag.js": {
      "types": "./dist/jsx-tag.d.ts",
      "import": "./dist/jsx-tag.js",
      "require": "./dist/jsx-tag.cjs"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "require": "./dist/standalone.cjs"
    },
    "./standalone.js": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "require": "./dist/standalone.cjs"
    },
    "./umd": {
      "require": "./dist/umd.js"
    },
    "./umd.js": {
      "require": "./dist/umd.js"
    },
    "./package.json": "./dist/package.json"
  }
}