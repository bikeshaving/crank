{
  "name": "@b9g/crank-hot",
  "version": "0.0.0",
  "private": true,
  "description": "An experiment in hot reloading for Crank components",
  "repository": {
    "type": "git",
    "url": "https://github.com/bikeshaving/crank.git",
    "directory": "packages/crank-hot"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    "./transform": "./src/transform.ts",
    "./runtime": "./src/runtime.js",
    "./bun": "./src/bun.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "test": "bun test test/",
    "test:e2e": "cd example && bun test ../e2e/bun.e2e.ts && bun test ../e2e/vite.e2e.ts",
    "dev": "cd example && bun dev.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@b9g/crank": ">=0.7.0"
  },
  "devDependencies": {
    "@b9g/crank": "file:../../",
    "@types/bun": "^1.3.0",
    "vite": "^8.3.8"
  }
}
